<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The framework's showcase: a console window with the interesting features in one place. .NET 11 only: it uses
         the board layout, the 3D components and the magic glow. -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net11.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AI_FGF.Showcase</RootNamespace>
    <AssemblyName>AI_FGF.Showcase</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Segoe UI, 9pt</ApplicationDefaultFont>
    <ApplicationVisualStyles>true</ApplicationVisualStyles>
    <ApplicationUseCompatibleTextRendering>false</ApplicationUseCompatibleTextRendering>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI_FGF\AI_FGF.csproj" />
  </ItemGroup>

</Project>
