<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dark MidnightBlue-style Avalonia showcase: tool.json only, no code - see Program.cs -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0;net11.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AI_FGF.Demo.Midnight</RootNamespace>
    <AssemblyName>AI_FGF.Demo.Midnight</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI_FGF.Avalonia\AI_FGF.Avalonia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tool.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
