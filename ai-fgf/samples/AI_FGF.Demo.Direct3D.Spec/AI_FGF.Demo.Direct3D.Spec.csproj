<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Dark MidnightBlue Avalonia showcase with the real Direct3D 12 renderer: tool.json only, no
         AiFgfD3D-specific code - see Program.cs. Windows-only (the add-on is net11.0-windows7.0). -->
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net10.0-windows7.0;net11.0-windows7.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AI_FGF.Demo.Direct3D.Spec</RootNamespace>
    <AssemblyName>AI_FGF.Demo.Direct3D.Spec</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AI_FGF.Avalonia\AI_FGF.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\AI_FGF.Avalonia.Direct3D\AI_FGF.Avalonia.Direct3D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="tool.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
