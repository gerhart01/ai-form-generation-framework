<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The Direct3D 12 face renderer (one shader, one device) shared by the WinForms controls and the Avalonia add-on. -->
    <TargetFrameworks>net10.0-windows;net11.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AI_FGF</RootNamespace>
    <AssemblyName>AI_FGF.Direct3D</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Vortice.Direct3D12" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
  </ItemGroup>

</Project>
