<Project>
  <!-- Package metadata shared by the libraries under src/ (tools/Pack.ps1 packs AI_FGF.Core, AI_FGF, AI_FGF.Avalonia). -->
  <PropertyGroup>
    <Authors>Arthur Khudyaev</Authors>
    <Copyright>Copyright (c) 2026 Arthur Khudyaev</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>winforms;avalonia;forms;gui;dpi;tool-runner;layout</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
